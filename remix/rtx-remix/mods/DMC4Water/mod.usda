#usda 1.0
(
    doc = "DMC4 water for RTX Remix. dmc4_hook's Remix bridge draws each kind of water shader with its own stand-in texture (4x4 of the default water colour, bytes 0x0F0D08FF, with the kind added to the blue byte: 0 XfWater, 1 XfWater's gXfViewProjI pixel shader, 2 XfInteractiveWater, 3 XfFlowingWater, 4 XfFlatWater, 5 puddles: XfWater draws narrower than the bridge's puddle size); its hash names the material, here under each way Remix may hash it (the filled or the still-empty texture, XXH3 or the old XXH64). Kinds 0, 1, 3 (sea, rivers): dark water, roughness 0.03, the wave normal map at half its tilt (textures/dmc4_water_normal_soft.dds); kinds 2, 4: as before, glossy dark water with the generated wave normal map (textures/dmc4_water_normal.dds, unsigned octahedral), scrolled; rtx.conf tags the same hashes as animated water for Remix's layered water normals. Kind 5: a thin, smooth film of clear water (translucent, thin-walled), not animated."
    upAxis = "Y"
)

def Xform "RootNode"
{
    def Scope "Looks"
    {
        # filled xxh3
        def Material "mat_815203BE4DC25162"
        {
            token outputs:mdl:displacement.connect = </RootNode/Looks/mat_815203BE4DC25162/Shader.outputs:out>
            token outputs:mdl:surface.connect = </RootNode/Looks/mat_815203BE4DC25162/Shader.outputs:out>
            token outputs:mdl:volume.connect = </RootNode/Looks/mat_815203BE4DC25162/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @AperturePBR_Opacity.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "AperturePBR_Opacity"
                color3f inputs:diffuse_color_constant = (0.012, 0.03, 0.04)
                float inputs:reflection_roughness_constant = 0.03
                float inputs:metallic_constant = 0
                asset inputs:normalmap_texture = @./textures/dmc4_water_normal_soft.dds@ (
                    colorSpace = "raw"
                )
                float inputs:texture_scroll_rate = 0.02
                float inputs:texture_scroll_angle = 25
                float2 inputs:texture_scale = (1, 1)
                token outputs:out
            }
        }

